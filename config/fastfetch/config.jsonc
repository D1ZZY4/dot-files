{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "CachyOS",
    "padding": {
      "top": 1,
      "right": 3
    }
  },
  "display": {
    "separator": "  ",
    "key": {
      "type": "icon",
      "paddingLeft": 1
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "Welcome, {user-name}!",
      "color": "gradient(175, 135, 255)"
    },
    "separator",
    {
      "type": "custom",
      "format": "Hardware",
      "outputColor": "blue"
    },
    {
      "type": "host",
      "key": "Host",
      "keyColor": "blue"
    },
    {
      "type": "cpu",
      "key": "CPU",
      "keyColor": "blue"
    },
    {
      "type": "gpu",
      "key": "GPU",
      "keyColor": "blue"
    },
    {
      "type": "disk",
      "key": "Disk",
      "keyColor": "blue",
      "folders": "/"
    },
    {
      "type": "memory",
      "key": "RAM",
      "keyColor": "blue",
      "color": "blue"
    },
    {
      "type": "swap",
      "key": "Swap",
      "keyColor": "blue"
    },
    {
      "type": "custom",
      "format": "System",
      "outputColor": "green"
    },
    {
      "type": "os",
      "key": "OS",
      "keyColor": "green"
    },
    {
      "type": "kernel",
      "key": "Kernel",
      "keyColor": "green"
    },
    {
      "type": "uptime",
      "key": "Uptime",
      "keyColor": "green"
    },
    {
      "type": "packages",
      "key": "Packages",
      "keyColor": "green"
    },
    {
      "type": "shell",
      "key": "Shell",
      "keyColor": "green"
    },
    {
      "type": "custom",
      "format": "Desktop",
      "outputColor": "magenta"
    },
    {
      "type": "wm",
      "key": "WM",
      "keyColor": "magenta"
    },
    {
      "type": "de",
      "key": "DE",
      "keyColor": "magenta"
    },
    {
      "type": "terminal",
      "key": "Term",
      "keyColor": "magenta"
    },
    {
      "type": "terminalfont",
      "key": "Font",
      "keyColor": "magenta"
    },
    {
      "type": "custom",
      "format": "Power",
      "outputColor": "yellow"
    },
    {
      "type": "battery",
      "key": "Battery",
      "keyColor": "yellow"
    }
  ]
}
